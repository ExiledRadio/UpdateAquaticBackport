config.updateaquaticbackport.blocks.enabled=Enabled
config.updateaquaticbackport.blocks.enabled.tooltip=Prismarine stairs and slabs, carved pumpkins, wood blocks from logs and the other small changes.
config.updateaquaticbackport.mobs.enabled=Enabled
config.updateaquaticbackport.mobs.enabled.tooltip=1.13's changes to existing mobs: undead sinking, squid ink, polar bears on ice and the rest.
config.updateaquaticbackport.water.enabled=Enabled
config.updateaquaticbackport.water.enabled.tooltip=Biome water colors, underwater fog, gradual air refill and the rest of 1.13's water changes.
config.updateaquaticbackport.woodset.tooltip=Stripped logs and wood, the five wood trapdoors, buttons and pressure plates, blue ice and sea pickles.
config.updateaquaticbackport.kelp.tooltip=Kelp, dried kelp and seagrass.
