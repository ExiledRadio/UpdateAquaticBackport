config.updateaquaticbackport.oceans.enabled=Enabled
config.updateaquaticbackport.oceans.enabled.tooltip=1.13's warm, lukewarm, cold and frozen oceans, icebergs, and underwater caves and ravines.
config.updateaquaticbackport.bubbles.enabled=Enabled
