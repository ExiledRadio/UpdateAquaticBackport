# --- swim ---
config.updateaquaticbackport.swimming=Nage et ramper
config.updateaquaticbackport.swimming.tooltip=Nage et ramper : courez sous l'eau pour nager, et rampez là où il n'y a pas la place de vous tenir debout.
config.updateaquaticbackport.swimming.enabled=Nage
config.updateaquaticbackport.swimming.enabled.tooltip=Courez la tête sous l'eau pour nager : vous êtes allongé dans une forme de 0.6 bloc de haut, allez plus vite, suivez la direction de votre regard et passez par les ouvertures d'un bloc. Sur un serveur, c'est le réglage du serveur qui compte.
config.updateaquaticbackport.swimming.crawling=Ramper
config.updateaquaticbackport.swimming.crawling.tooltip=Sans la place de vous tenir debout ni de vous accroupir, vous rampez : allongé au sol à la vitesse accroupie, jusqu'à ce qu'il y ait de nouveau de la place. Cela arrive en entrant à la nage dans une ouverture d'un bloc, ou sous une trappe fermée.

